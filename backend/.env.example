# Supabase (proyecto Connectboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Client ID creado en Google Cloud Console)
GOOGLE_CLIENT_ID=

# Dominio institucional al que se restringe el login
