# Supabase (proyecto Connectboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Google OAuth (Client ID creado en Google Cloud Console)
GOOGLE_CLIENT_ID=

# Dominio institucional al que se restringe el login
DOMINIO_INSTITUCIONAL=duocuc.cl

# API de moderación de OpenAI (filtro de texto e imágenes antes de publicar)
OPENAI_API_KEY=

# Secreto para firmar los JWT propios del backend (genera uno random)
JWT_SECRET=

# Puerto del servidor
PORT=3000
